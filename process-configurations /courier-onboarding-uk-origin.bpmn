<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_CourierOnboarding"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.39.0">

  <!-- Boundary Error Definitions for Remediation -->
  <bpmn:error id="Error_BGC_Rejected" name="Error_BGC_Rejected" errorCode="BGC_REJECTED" />
  <bpmn:error id="Error_ID_ManualReview" name="Error_ID_ManualReview" errorCode="ID_MANUAL_REVIEW_REQUIRED" />
  <bpmn:error id="Error_Insurance_Rejected" name="Error_Insurance_Rejected" errorCode="INSURANCE_REJECTED" />

  <bpmn:process id="courier-onboarding-uk" name="Courier Onboarding UK" isExecutable="true" camunda:historyTimeToLive="P30D">

    <!-- 1. Applicant Registration Start Event -->
    <bpmn:startEvent id="StartEvent_CourierOnboarding" name="Applicant Registered&#10;(Keycloak Auth)" camunda:asyncBefore="true">
      <bpmn:outgoing>Flow_Start_To_FetchZone</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. Fetch Zone Metadata from CDZ -->
    <bpmn:serviceTask id="Task_FetchZoneData" name="Fetch Delivery Zone Metadata" camunda:asyncBefore="true" camunda:type="external" camunda:topic="fetch-zone-data">
      <bpmn:incoming>Flow_Start_To_FetchZone</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchZone_To_DmnEligibility</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 3. Evaluate Zone & Vehicle Eligibility via DMN -->
    <bpmn:businessRuleTask id="Task_DMN_ZoneEligibility" name="Evaluate Zone &amp; Vehicle Eligibility" camunda:asyncBefore="true" camunda:resultVariable="eligibilityDecision" camunda:decisionRef="decision_zone_vehicle_eligibility" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_FetchZone_To_DmnEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_DmnEligibility_To_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- Zone Eligibility Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ZoneEligibility" name="Eligible?" default="Flow_Zone_Eligible">
      <bpmn:incoming>Flow_DmnEligibility_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Zone_Eligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_Zone_Surplus</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 4A. Surplus/Waitlist Branch -->
    <bpmn:serviceTask id="Task_NotifySurplus" name="Notify Acquisition Surplus" camunda:asyncBefore="true" camunda:type="external" camunda:topic="notify-surplus">
      <bpmn:incoming>Flow_Zone_Surplus</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifySurplus_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Surplus" name="Surplus /&#10;Waitlisted">
      <bpmn:incoming>Flow_NotifySurplus_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 4B. Eligible Branch: Sync Zone & Vehicle Selection in Acquisition Service -->
    <bpmn:serviceTask id="Activity_0j2n7bv" name="Update Zone-Vehicle" camunda:asyncBefore="true" camunda:type="external" camunda:topic="update-zone-vehicle">
      <bpmn:incoming>Flow_Zone_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_0j480rw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 5. Parallel Requirements Engine Subprocess -->
    <bpmn:subProcess id="SubProcess_Requirements" name="Parallel Independent Requirements Engine" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_0j480rw</bpmn:incoming>
      <bpmn:outgoing>Flow_Requirements_To_DmnActivation</bpmn:outgoing>

      <bpmn:startEvent id="StartEvent_Requirements" name="Start Checks">
        <bpmn:outgoing>Flow_ReqStart_To_Fork</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:parallelGateway id="Gateway_Fork_Requirements" name="Spawn All Independent Checks">
        <bpmn:incoming>Flow_ReqStart_To_Fork</bpmn:incoming>
        <bpmn:outgoing>Flow_Fork_To_BGC</bpmn:outgoing>
        <bpmn:outgoing>Flow_Fork_To_ID</bpmn:outgoing>
        <bpmn:outgoing>Flow_Fork_To_Insurance</bpmn:outgoing>
        <bpmn:outgoing>Flow_Fork_To_Bag</bpmn:outgoing>
        <bpmn:outgoing>Flow_Fork_To_Bank</bpmn:outgoing>
      </bpmn:parallelGateway>

      <!-- Track 1: Background Check -->
      <bpmn:userTask id="Task_BGC_Remediation" name="BGC Submission" camunda:candidateGroups="applicants">
        <bpmn:incoming>Flow_Fork_To_BGC</bpmn:incoming>
        <bpmn:incoming>Flow_BGC_Rejected</bpmn:incoming>
        <bpmn:outgoing>Flow_BGC_Remediate_Loop</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_BGC_Check" name="Verify BGC&#10;(CH &amp; RTW)" camunda:asyncBefore="true" camunda:type="external" camunda:topic="sterling-bgc-check">
        <bpmn:incoming>Flow_BGC_Remediate_Loop</bpmn:incoming>
        <bpmn:outgoing>Flow_BGC_To_Join</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:boundaryEvent id="Boundary_BGC_Rejected" name="BGC Rejected" attachedToRef="Task_BGC_Check">
        <bpmn:outgoing>Flow_BGC_Rejected</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_BGC" errorRef="Error_BGC_Rejected" />
      </bpmn:boundaryEvent>

      <!-- Track 2: Identity Verification (Topic updated to document-verification) -->
      <bpmn:userTask id="Task_ID_Remediation" name="Upload Government ID" camunda:candidateGroups="applicants">
        <bpmn:incoming>Flow_Fork_To_ID</bpmn:incoming>
        <bpmn:incoming>Flow_0msq1d9</bpmn:incoming>
        <bpmn:outgoing>Flow_ID_Remediate_Loop</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_ID_Verification" name="Verify Identity&#10;(Document Service)" camunda:asyncBefore="true" camunda:type="external" camunda:topic="document-verification">
        <bpmn:incoming>Flow_ID_Remediate_Loop</bpmn:incoming>
        <bpmn:outgoing>Flow_ID_To_Join</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:boundaryEvent id="Boundary_ID_ManualReview" name="ID rejected" attachedToRef="Task_ID_Verification">
        <bpmn:outgoing>Flow_0msq1d9</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_ID_LO" errorRef="Error_ID_ManualReview" />
      </bpmn:boundaryEvent>

      <!-- Track 3: Commercial Insurance -->
      <bpmn:userTask id="Task_Insurance_Remediation" name="Upload Commercial Insurance" camunda:candidateGroups="applicants">
        <bpmn:incoming>Flow_Fork_To_Insurance</bpmn:incoming>
        <bpmn:incoming>Flow_Ins_Rejected</bpmn:incoming>
        <bpmn:outgoing>Flow_Ins_Remediate_Loop</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Insurance_Verification" name="Verify Business Insurance" camunda:asyncBefore="true" camunda:type="external" camunda:topic="verify-insurance">
        <bpmn:incoming>Flow_Ins_Remediate_Loop</bpmn:incoming>
        <bpmn:outgoing>Flow_Insurance_To_Join</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:boundaryEvent id="Boundary_Insurance_Rejected" name="Insurance Invalid" attachedToRef="Task_Insurance_Verification">
        <bpmn:outgoing>Flow_Ins_Rejected</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_Ins" errorRef="Error_Insurance_Rejected" />
      </bpmn:boundaryEvent>

      <!-- Track 4: Thermal Bag Equipment -->
      <bpmn:userTask id="Activity_1ah8sz4" name="Update Bag condition" camunda:candidateGroups="applicants">
        <bpmn:incoming>Flow_Fork_To_Bag</bpmn:incoming>
        <bpmn:outgoing>Flow_1urzbyt</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Bag_Verification" name="Verify Thermal Bag" camunda:asyncBefore="true" camunda:type="external" camunda:topic="verify-thermal-bag">
        <bpmn:incoming>Flow_1urzbyt</bpmn:incoming>
        <bpmn:outgoing>Flow_Bag_To_Join</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- Track 5: Bank Details -->
      <bpmn:userTask id="Activity_1d83ijo" name="Update Bank Details" camunda:candidateGroups="applicants">
        <bpmn:incoming>Flow_Fork_To_Bank</bpmn:incoming>
        <bpmn:outgoing>Flow_1wcaytt</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Bank_Verification" name="Verify Bank Details" camunda:asyncBefore="true" camunda:type="external" camunda:topic="verify-bank-details">
        <bpmn:incoming>Flow_1wcaytt</bpmn:incoming>
        <bpmn:outgoing>Flow_Bank_To_Join</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- Requirements Join Gateway -->
      <bpmn:parallelGateway id="Gateway_Join_Requirements" name="Synchronize All Checks">
        <bpmn:incoming>Flow_BGC_To_Join</bpmn:incoming>
        <bpmn:incoming>Flow_ID_To_Join</bpmn:incoming>
        <bpmn:incoming>Flow_Insurance_To_Join</bpmn:incoming>
        <bpmn:incoming>Flow_Bag_To_Join</bpmn:incoming>
        <bpmn:incoming>Flow_Bank_To_Join</bpmn:incoming>
        <bpmn:outgoing>Flow_Join_To_SubEnd</bpmn:outgoing>
      </bpmn:parallelGateway>

      <bpmn:endEvent id="EndEvent_Requirements" name="Checks Synchronized">
        <bpmn:incoming>Flow_Join_To_SubEnd</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Subprocess Sequence Flows -->
      <bpmn:sequenceFlow id="Flow_ReqStart_To_Fork" sourceRef="StartEvent_Requirements" targetRef="Gateway_Fork_Requirements" />
      <bpmn:sequenceFlow id="Flow_Fork_To_BGC" sourceRef="Gateway_Fork_Requirements" targetRef="Task_BGC_Remediation" />
      <bpmn:sequenceFlow id="Flow_Fork_To_ID" sourceRef="Gateway_Fork_Requirements" targetRef="Task_ID_Remediation" />
      <bpmn:sequenceFlow id="Flow_Fork_To_Insurance" sourceRef="Gateway_Fork_Requirements" targetRef="Task_Insurance_Remediation" />
      <bpmn:sequenceFlow id="Flow_Fork_To_Bag" sourceRef="Gateway_Fork_Requirements" targetRef="Activity_1ah8sz4" />
      <bpmn:sequenceFlow id="Flow_Fork_To_Bank" sourceRef="Gateway_Fork_Requirements" targetRef="Activity_1d83ijo" />
      <bpmn:sequenceFlow id="Flow_BGC_Remediate_Loop" sourceRef="Task_BGC_Remediation" targetRef="Task_BGC_Check" />
      <bpmn:sequenceFlow id="Flow_BGC_To_Join" sourceRef="Task_BGC_Check" targetRef="Gateway_Join_Requirements" />
      <bpmn:sequenceFlow id="Flow_BGC_Rejected" sourceRef="Boundary_BGC_Rejected" targetRef="Task_BGC_Remediation" />
      <bpmn:sequenceFlow id="Flow_ID_Remediate_Loop" sourceRef="Task_ID_Remediation" targetRef="Task_ID_Verification" />
      <bpmn:sequenceFlow id="Flow_ID_To_Join" sourceRef="Task_ID_Verification" targetRef="Gateway_Join_Requirements" />
      <bpmn:sequenceFlow id="Flow_0msq1d9" sourceRef="Boundary_ID_ManualReview" targetRef="Task_ID_Remediation" />
      <bpmn:sequenceFlow id="Flow_Ins_Remediate_Loop" sourceRef="Task_Insurance_Remediation" targetRef="Task_Insurance_Verification" />
      <bpmn:sequenceFlow id="Flow_Insurance_To_Join" sourceRef="Task_Insurance_Verification" targetRef="Gateway_Join_Requirements" />
      <bpmn:sequenceFlow id="Flow_Ins_Rejected" sourceRef="Boundary_Insurance_Rejected" targetRef="Task_Insurance_Remediation" />
      <bpmn:sequenceFlow id="Flow_1urzbyt" sourceRef="Activity_1ah8sz4" targetRef="Task_Bag_Verification" />
      <bpmn:sequenceFlow id="Flow_Bag_To_Join" sourceRef="Task_Bag_Verification" targetRef="Gateway_Join_Requirements" />
      <bpmn:sequenceFlow id="Flow_1wcaytt" sourceRef="Activity_1d83ijo" targetRef="Task_Bank_Verification" />
      <bpmn:sequenceFlow id="Flow_Bank_To_Join" sourceRef="Task_Bank_Verification" targetRef="Gateway_Join_Requirements" />
      <bpmn:sequenceFlow id="Flow_Join_To_SubEnd" sourceRef="Gateway_Join_Requirements" targetRef="EndEvent_Requirements" />
    </bpmn:subProcess>

    <!-- 6. Activation Gate Evaluation via DMN -->
    <bpmn:businessRuleTask id="Task_DMN_ActivationGate" name="Evaluate Activation Gate Fulfillment" camunda:asyncBefore="true" camunda:resultVariable="activationGateDecision" camunda:decisionRef="decision_activation_gate" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_Requirements_To_DmnActivation</bpmn:incoming>
      <bpmn:incoming>Flow_Activation_Remediate_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_DmnActivation_To_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- Activation Permitted Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ActivationGate" name="Activation Permitted?">
      <bpmn:incoming>Flow_DmnActivation_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Activation_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Activation_Blocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Activation_Remediation" name="Review Missing Compliance Reqs" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_Activation_Blocked</bpmn:incoming>
      <bpmn:outgoing>Flow_Activation_Remediate_Loop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 7. 70/30 Split Gateway -->
    <bpmn:exclusiveGateway id="Gateway_70_30_Split" name="70% Auto /&#10;30% LiveOps Audit" default="Flow_Auto_Activate">
      <bpmn:incoming>Flow_Activation_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_Activate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual_Audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 30% LiveOps Audit Queue with 2-Hour SLA Timer -->
    <bpmn:userTask id="Task_LiveOps_ActivationQueue" name="LiveOps Activation Audit" camunda:asyncBefore="true" camunda:candidateGroups="liveops-agents">
      <bpmn:incoming>Flow_Manual_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_LiveOpsAudit_Approved</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_SLA_2Hours" name="2h SLA Breach" cancelActivity="false" attachedToRef="Task_LiveOps_ActivationQueue">
      <bpmn:outgoing>Flow_SLA_Alert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_2H">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Notify_SLA_Breach" name="Alert LiveOps Team Lead" camunda:type="external" camunda:topic="notify-sla-breach">
      <bpmn:incoming>Flow_SLA_Alert</bpmn:incoming>
      <bpmn:outgoing>Flow_SLA_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_SLA_Alert" name="SLA Alert Dispatched">
      <bpmn:incoming>Flow_SLA_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 8. Final Profile Activation in Acquisition Service -->
    <bpmn:serviceTask id="Task_ActivateCourier" name="Activate Courier Profile" camunda:asyncBefore="true" camunda:type="external" camunda:topic="activate-courier-profile">
      <bpmn:incoming>Flow_Auto_Activate</bpmn:incoming>
      <bpmn:incoming>Flow_LiveOpsAudit_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Activate_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_CourierActive" name="Courier Activated">
      <bpmn:incoming>Flow_Activate_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Main Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_FetchZone" sourceRef="StartEvent_CourierOnboarding" targetRef="Task_FetchZoneData" />
    <bpmn:sequenceFlow id="Flow_FetchZone_To_DmnEligibility" sourceRef="Task_FetchZoneData" targetRef="Task_DMN_ZoneEligibility" />
    <bpmn:sequenceFlow id="Flow_DmnEligibility_To_Gateway" sourceRef="Task_DMN_ZoneEligibility" targetRef="Gateway_ZoneEligibility" />
    <bpmn:sequenceFlow id="Flow_Zone_Eligible" name="Eligible" sourceRef="Gateway_ZoneEligibility" targetRef="Activity_0j2n7bv" />
    <bpmn:sequenceFlow id="Flow_0j480rw" sourceRef="Activity_0j2n7bv" targetRef="SubProcess_Requirements" />
    <bpmn:sequenceFlow id="Flow_Zone_Surplus" name="Surplus" sourceRef="Gateway_ZoneEligibility" targetRef="Task_NotifySurplus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eligibilityDecision.eligibilityResult == 'SURPLUS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotifySurplus_To_End" sourceRef="Task_NotifySurplus" targetRef="EndEvent_Surplus" />
    <bpmn:sequenceFlow id="Flow_Requirements_To_DmnActivation" sourceRef="SubProcess_Requirements" targetRef="Task_DMN_ActivationGate" />
    <bpmn:sequenceFlow id="Flow_DmnActivation_To_Gateway" sourceRef="Task_DMN_ActivationGate" targetRef="Gateway_ActivationGate" />
    <bpmn:sequenceFlow id="Flow_Activation_Approved" name="Allowed" sourceRef="Gateway_ActivationGate" targetRef="Gateway_70_30_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${activationGateDecision.activationAllowed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Activation_Blocked" name="Blocked" sourceRef="Gateway_ActivationGate" targetRef="Task_Activation_Remediation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${activationGateDecision.activationAllowed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Activation_Remediate_Loop" sourceRef="Task_Activation_Remediation" targetRef="Task_DMN_ActivationGate" />
    <bpmn:sequenceFlow id="Flow_Auto_Activate" name="&lt;= 70% Auto" sourceRef="Gateway_70_30_Split" targetRef="Task_ActivateCourier" />
    <bpmn:sequenceFlow id="Flow_Manual_Audit" name="&gt; 30% Audit" sourceRef="Gateway_70_30_Split" targetRef="Task_LiveOps_ActivationQueue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${randomActivationScore &gt; 70}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LiveOpsAudit_Approved" sourceRef="Task_LiveOps_ActivationQueue" targetRef="Task_ActivateCourier" />
    <bpmn:sequenceFlow id="Flow_SLA_Alert" sourceRef="Boundary_SLA_2Hours" targetRef="Task_Notify_SLA_Breach" />
    <bpmn:sequenceFlow id="Flow_SLA_End" sourceRef="Task_Notify_SLA_Breach" targetRef="EndEvent_SLA_Alert" />
    <bpmn:sequenceFlow id="Flow_Activate_To_End" sourceRef="Task_ActivateCourier" targetRef="EndEvent_CourierActive" />
  </bpmn:process>

  <!-- Complete Visual Diagram Interchange (DI) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="courier-onboarding-uk">
      <bpmndi:BPMNShape id="StartEvent_CourierOnboarding_di" bpmnElement="StartEvent_CourierOnboarding">
        <dc:Bounds x="162" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="142" y="265" width="78" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchZoneData_di" bpmnElement="Task_FetchZoneData">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DMN_ZoneEligibility_di" bpmnElement="Task_DMN_ZoneEligibility">
        <dc:Bounds x="390" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ZoneEligibility_di" bpmnElement="Gateway_ZoneEligibility" isMarkerVisible="true">
        <dc:Bounds x="545" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="493" y="222" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0q00dni" bpmnElement="Activity_0j2n7bv">
        <dc:Bounds x="640" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifySurplus_di" bpmnElement="Task_NotifySurplus">
        <dc:Bounds x="650" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Surplus_di" bpmnElement="EndEvent_Surplus">
        <dc:Bounds x="792" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="787" y="145" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Requirements_di" bpmnElement="SubProcess_Requirements" isExpanded="true">
        <dc:Bounds x="770" y="200" width="748" height="770" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Requirements_di" bpmnElement="StartEvent_Requirements">
        <dc:Bounds x="790" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="777" y="645" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_Requirements_di" bpmnElement="Gateway_Fork_Requirements">
        <dc:Bounds x="863" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="887" y="570" width="62" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BGC_Remediation_di" bpmnElement="Task_BGC_Remediation">
        <dc:Bounds x="1008" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BGC_Check_di" bpmnElement="Task_BGC_Check">
        <dc:Bounds x="1168" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_BGC_Rejected_di" bpmnElement="Boundary_BGC_Rejected">
        <dc:Bounds x="1150" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1182" y="373" width="71" height="14" />
        </bpmndi:BPMNLabel>
